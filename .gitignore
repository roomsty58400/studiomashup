# ── Dépendances ──
node_modules/

# ── Caches Python (partout, pas seulement la racine) ──
__pycache__/
*.pyc

# ── Secrets / config locale (clés API, identifiants OAuth) ──
.env
.env.*
client_secret_*.json
*.pem
*.key

# ── Logs ──
logs/
*.log

# ── Données générées / temporaires (backend) ──
backend/tmp/
backend/cache/
backend/data/outputs/
backend/data/analyze/
backend/data/audio-separator-models/
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# ── Build frontend ──
frontend/dist/
frontend/.vite/

# ── OS / éditeurs ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
